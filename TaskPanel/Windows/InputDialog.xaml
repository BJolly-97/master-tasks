<Window x:Class="TaskPanel.Windows.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="280"
        Topmost="True">
    <Border Background="#EE1E1E28" CornerRadius="10" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <StackPanel>
            <TextBlock x:Name="PromptText" Text="Name:" Foreground="#DDFFFFFF" FontSize="13" Margin="0,0,0,8"/>
            <TextBox x:Name="InputBox" Background="#22FFFFFF" Foreground="White" BorderBrush="#33FFFFFF"
                     BorderThickness="1" Padding="6,4" FontSize="13" CaretBrush="White"
                     KeyDown="InputBox_KeyDown"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" Click="Cancel_Click" Width="70" Margin="0,0,8,0"
                        Background="Transparent" Foreground="#BBFFFFFF" BorderThickness="0" Padding="4"/>
                <Button Content="OK" Click="Ok_Click" Width="70"
                        Background="#4478C0FF" Foreground="White" BorderThickness="0" Padding="4"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
