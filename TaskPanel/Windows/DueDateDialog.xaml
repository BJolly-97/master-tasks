<Window x:Class="TaskPanel.Windows.DueDateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="290"
        Topmost="True">

    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../Styles/Bevel.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <Style x:Key="QuickPickStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="#1A43978D"/>
            <Setter Property="Foreground" Value="#EEFFFFFF"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{StaticResource BevelBorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3343978D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
      </ResourceDictionary>
    </Window.Resources>

    <Border Background="#EE1E1E28" CornerRadius="10" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <StackPanel>
            <TextBlock x:Name="PromptText" Text="Due date for task" Foreground="#DDFFFFFF" FontSize="13"
                       TextWrapping="Wrap" Margin="0,0,0,10"/>

            <TextBox x:Name="DateBox" Background="#22FFFFFF" Foreground="White" BorderBrush="#33FFFFFF"
                     BorderThickness="1" Padding="6,4" FontSize="13" CaretBrush="White"
                     KeyDown="DateBox_KeyDown"/>
            <TextBlock Text="yyyy-mm-dd" Foreground="#60FFFFFF" FontSize="10.5" Margin="2,3,0,0"/>

            <TextBlock x:Name="ErrorText" Text="That doesn't look like a date." Foreground="#F9AD6A" FontSize="11"
                       Margin="2,4,0,0" Visibility="Collapsed"/>

            <WrapPanel Margin="0,10,0,0">
                <Button Content="Today" Click="QuickPick_Click" Tag="0" Style="{StaticResource QuickPickStyle}"/>
                <Button Content="Tomorrow" Click="QuickPick_Click" Tag="1" Style="{StaticResource QuickPickStyle}"/>
                <Button Content="+3 days" Click="QuickPick_Click" Tag="3" Style="{StaticResource QuickPickStyle}"/>
                <Button Content="+1 week" Click="QuickPick_Click" Tag="7" Style="{StaticResource QuickPickStyle}"/>
            </WrapPanel>

            <Grid Margin="0,16,0,0">
                <Button Content="Clear date" Click="Clear_Click" HorizontalAlignment="Left" Padding="4"
                        Background="#22D46C4E" Foreground="#F9AD6A" Style="{StaticResource BeveledActionButtonStyle}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="Cancel_Click" Width="70" Margin="0,0,8,0" Padding="4"
                            Background="#22FFFFFF" Foreground="#DDFFFFFF" Style="{StaticResource BeveledActionButtonStyle}"/>
                    <Button Content="Save" Click="Save_Click" Width="70" Padding="4"
                            Background="#4478C0FF" Foreground="White" Style="{StaticResource BeveledActionButtonStyle}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
