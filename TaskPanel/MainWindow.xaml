<Window x:Class="TaskPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:models="clr-namespace:TaskPanel.Models"
        Title="Master Tasks"
        Width="320" Height="480" MinWidth="260" MinHeight="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01264D59"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A43978D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same as IconButtonStyle, but hovers with a warning tint — used for destructive (delete) actions -->
        <Style x:Key="DangerIconButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#40D46C4E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded, checkmark-in-a-circle style for task checkboxes -->
        <Style x:Key="RoundedCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="19" Height="19">
                            <Ellipse x:Name="Circle" Stroke="#8043978D" StrokeThickness="1.5" Fill="Transparent"/>
                            <Path x:Name="Check" Stroke="#264D59" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 5,10 L 8.2,13.2 L 14.5,6" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Stroke" Value="#F9E07F"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="#F9E07F"/>
                                <Setter TargetName="Circle" Property="Stroke" Value="#F9E07F"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin, translucent scrollbars everywhere in the window (tab strip overflow, task lists) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3843978D" CornerRadius="4" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="#3843978D" CornerRadius="4" Margin="0,1"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Pill-shaped button, used for the tab strip's "Archive" and "+" actions -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F0FFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="12" Margin="3,0" Padding="12,5"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2E43978D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared transparent, hover-highlighted row style for both task and archive list items -->
        <Style x:Key="TransparentListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A43978D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small pill button showing a task's due date (or a calendar glyph if unset) -->
        <Style x:Key="DueDatePillStyle" TargetType="Button">
            <Setter Property="Content" Value="{Binding DueDateLabel}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#80FFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ToolTip" Value="Set a due date"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A43978D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                    <Setter Property="Background" Value="#33D46C4E"/>
                    <Setter Property="Foreground" Value="#FFF3E0DA"/>
                    <Setter Property="ToolTip" Value="Due soon — click to change"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Task row: checking it off archives it immediately -->
        <DataTemplate DataType="{x:Type models:TaskItem}">
            <Grid Margin="2,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="2,0,8,0"
                          IsChecked="{Binding IsDone, Mode=TwoWay}"
                          Checked="TaskDone_Checked"
                          Style="{StaticResource RoundedCheckBoxStyle}"/>
                <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="#F0FFFFFF" FontSize="13"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="2" Click="DueDate_Click" VerticalAlignment="Center"
                        Style="{StaticResource DueDatePillStyle}"/>
                <Button Grid.Column="3" Content="&#x2715;" FontSize="10"
                        Width="22" Height="22" Padding="0" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Foreground="#80FFFFFF"
                        ToolTip="Remove task" Click="DeleteTask_Click"
                        Style="{StaticResource DangerIconButtonStyle}"/>
            </Grid>
        </DataTemplate>

        <!-- Archived task row -->
        <DataTemplate DataType="{x:Type models:ArchivedTask}">
            <Grid Margin="2,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Text}" Foreground="#90FFFFFF" FontSize="13"
                           TextDecorations="Strikethrough" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="&#x21BA;" FontSize="12"
                        Width="22" Height="22" Padding="0" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Foreground="#80FFFFFF"
                        ToolTip="Restore to its list" Click="RestoreTask_Click"
                        Style="{StaticResource IconButtonStyle}"/>
                <Button Grid.Column="2" Content="&#x2715;" FontSize="10" Margin="2,0,0,0"
                        Width="22" Height="22" Padding="0" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Foreground="#80FFFFFF"
                        ToolTip="Delete permanently" Click="DeleteArchived_Click"
                        Style="{StaticResource DangerIconButtonStyle}"/>
            </Grid>
        </DataTemplate>

        <!-- Per-list tab content: task list + add-task row -->
        <DataTemplate DataType="{x:Type models:TaskListModel}">
            <Grid Margin="10,8,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" ItemsSource="{Binding Tasks}"
                          Background="Transparent" BorderThickness="0"
                          ItemContainerStyle="{StaticResource TransparentListBoxItem}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Loaded="TaskListBox_Loaded">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Margin="4,8,0,4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Name}" Value="True">
                                                        <Setter Property="Text" Value="&#x26A0; Urgent — due within a week"/>
                                                        <Setter Property="Foreground" Value="#D46C4E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="False">
                                                        <Setter Property="Text" Value="General"/>
                                                        <Setter Property="Foreground" Value="#F9E07F"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Background="#18FFFFFF" Foreground="White" CaretBrush="White"
                              BorderBrush="#4443978D" BorderThickness="1" Padding="7,5" FontSize="13"
                              VerticalContentAlignment="Center"
                              KeyDown="AddTask_KeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Resources>
                                    <VisualBrush x:Key="PlaceholderBrush" TileMode="None" Opacity="0.45" Stretch="None" AlignmentX="Left">
                                        <VisualBrush.Visual>
                                            <TextBlock Text="Add a task..." Foreground="White" FontSize="13" Margin="4,0,0,0"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Style.Resources>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="{StaticResource PlaceholderBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button Grid.Column="1" Content="Add" Margin="6,0,0,0" Padding="10,5"
                            Background="#8043978D" Foreground="White" BorderThickness="0"
                            Click="AddTask_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Tab header pill -->
        <Style x:Key="PillTabItem" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bg" CornerRadius="12" Margin="3,0" Padding="12,5"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                                MouseRightButtonUp="TabHeader_RightClick"
                                MouseLeftButtonDown="TabHeader_Click">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#5D43978D"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#8043978D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="Transparent"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="#2E43978D"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="#7043978D"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Foreground="#F0FFFFFF" FontSize="12.5"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <CollectionViewSource x:Key="ArchiveGroupedView">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="SourceListName"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Border CornerRadius="12" BorderBrush="#4443978D" BorderThickness="1" Background="Transparent" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar / drag region -->
            <Grid Grid.Row="0" Background="#1A43978D">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Master Tasks" Foreground="#99FFFFFF" FontSize="12"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button Grid.Column="1" Content="&#x2013;" FontSize="14"
                        Width="30" Height="24" Margin="0,0,4,0" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Foreground="#BBFFFFFF"
                        ToolTip="Hide to tray" Click="Hide_Click" Style="{StaticResource IconButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <!-- Tab strip: work-region tabs + Archive + New tab, all customisable / created on the fly -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Margin="6,4,6,0" Padding="0,0,0,2">
                <StackPanel Orientation="Horizontal">
                    <TabControl x:Name="ListsTabControl"
                                ItemsSource="{Binding Lists}"
                                ItemContainerStyle="{StaticResource PillTabItem}"
                                Background="Transparent" BorderThickness="0"
                                Padding="0"
                                SelectionChanged="ListsTabControl_SelectionChanged">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <TabPanel IsItemsHost="True" Background="Transparent"/>
                            </ControlTemplate>
                        </TabControl.Template>
                    </TabControl>
                    <Button x:Name="ArchiveButton" Content="Archive" ToolTip="Completed tasks"
                            Style="{StaticResource PillButtonStyle}" Click="ShowArchive_Click"/>
                    <Button Content="&#x2795; New" ToolTip="New list" FontSize="11.5"
                            Style="{StaticResource PillButtonStyle}" Click="NewList_Click"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Content: either the selected list, or the archive -->
            <Grid Grid.Row="2">
                <ContentPresenter x:Name="ListContentPresenter" Content="{Binding SelectedItem, ElementName=ListsTabControl}"/>

                <Grid x:Name="ArchivePanel" Visibility="Collapsed" Margin="10,8,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="&#x1F5CE; Export to .docx" HorizontalAlignment="Right"
                            Margin="0,0,0,8" Padding="10,5" Background="#8043978D" Foreground="White"
                            BorderThickness="0" ToolTip="Export what's currently archived as a Word report"
                            Click="ExportArchive_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Grid Grid.Row="1">
                        <TextBlock Text="Nothing archived yet — tick a task to send it here."
                                   x:Name="ArchiveEmptyHint" Foreground="#70FFFFFF" FontSize="12.5"
                                   TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Center"
                                   Margin="0,30,0,0"/>
                        <ListBox ItemsSource="{Binding Source={StaticResource ArchiveGroupedView}}"
                                  Background="Transparent" BorderThickness="0"
                                  ItemContainerStyle="{StaticResource TransparentListBoxItem}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Foreground="#F9E07F" FontSize="11"
                                                       FontWeight="SemiBold" Margin="4,10,0,4"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
